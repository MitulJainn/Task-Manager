# ===================================================
# TaskFlow — Smart Task Manager Environment Variables
# ===================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas URI or local instance)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/taskflow?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/taskflow
MONGODB_URI=mongodb://localhost:27017/taskflow

# Frontend URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173
